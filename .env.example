# Ollama runs on the host, not in Docker.
# Backend reaches it via host.docker.internal:11434 (see compose.yaml).
# Just make sure `ollama serve` is running and the model below is pulled.
CHAT_MODEL=qwen3.5:4b

EMBED_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional: raises Hugging Face Hub rate limits for model downloads.
# Leave blank to download unauthenticated (slower, still works).
HF_TOKEN=
